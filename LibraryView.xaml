<UserControl x:Class="FPSOverlay.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FPSOverlay"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="LibraryPrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#F24C1D" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF5A2E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryGhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#E8ECF2"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#18FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#28FFFFFF"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#F24C1D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type local:GameItem}">
            <Border x:Name="Card" Width="184" Height="308" CornerRadius="14" Margin="0,0,14,14"
                    Background="#1E1E1E" BorderBrush="#2A2A2A" BorderThickness="1.5"
                    Cursor="Hand" ClipToBounds="True"
                    MouseLeftButtonUp="GameCard_MouseLeftButtonUp">
                <Grid>
                    <!-- Cover / fallback -->
                    <Border Background="#161616" CornerRadius="13">
                        <Grid>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1A1A1A" Offset="0"/>
                                        <GradientStop Color="#2A1812" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Dark Mars fallback: title + optional centered EXE icon -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                                <Image x:Name="IconFallback" Width="64" Height="64" Stretch="Uniform"
                                       Source="{Binding CoverImage}"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsIconFallback}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Text="{Binding Title}" Foreground="#A0A0A0" FontSize="13" FontWeight="SemiBold"
                                           TextWrapping="Wrap" TextAlignment="Center" Opacity="0.9">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasCoverImage}" Value="True"/>
                                                        <Condition Binding="{Binding IsIconFallback}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Full vertical poster -->
                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasCoverImage}" Value="True"/>
                                                    <Condition Binding="{Binding IsIconFallback}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Grid>
                    </Border>

                    <!-- Soft scrim. The poster eases darker toward the bottom; no stats panel. -->
                    <Border IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="0.42"/>
                                <GradientStop Color="#1A000000" Offset="0.58"/>
                                <GradientStop Color="#73000000" Offset="0.74"/>
                                <GradientStop Color="#D0000000" Offset="0.88"/>
                                <GradientStop Color="#F20C0D10" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Platform badge -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                            Background="#99000000" CornerRadius="8" Padding="8,3">
                        <TextBlock Text="{Binding PlatformBadge}" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Hover veil + Play. Button sits above the stats strip. -->
                    <Border x:Name="HoverVeil" Opacity="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0.35" EndPoint="0.5,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#CC000000" Offset="0.55"/>
                                <GradientStop Color="#E6000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Button x:Name="BtnPlay" Content="Play"
                                Style="{StaticResource LibraryPrimaryBtn}"
                                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,108"
                                MinWidth="96" Click="BtnPlay_Click" Tag="{Binding}"
                                Loaded="BtnPlay_Loaded"/>
                    </Border>

                    <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,16" IsHitTestVisible="False">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatsFpsValue}" FontSize="20" FontWeight="Bold"
                                           Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock Text="FPS" FontSize="11" FontWeight="SemiBold" Foreground="#E7EBF1"
                                           Margin="5,2,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatsLowLabel}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#D5DBE3" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatsLowValue}" FontSize="15" FontWeight="Bold"
                                           Foreground="#FFFFFF" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GPU" FontSize="11" FontWeight="SemiBold" Foreground="#E4E8EF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding StatsGpuMax}" FontSize="14" FontWeight="Bold"
                                       Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="MAX" FontSize="10" FontWeight="Bold"
                                       Foreground="#F4F6F8" Margin="5,1,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding StatsGpuAvg}" FontSize="11" Foreground="#E4E8EF"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Row="1" Margin="0,4,0,0" Text="CPU" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#E4E8EF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Text="{Binding StatsCpuMax}"
                                       FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="5,5,0,0" Text="MAX" FontSize="10" FontWeight="Bold"
                                       Foreground="#F4F6F8" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="4" Margin="0,4,0,0" Text="{Binding StatsCpuAvg}"
                                       FontSize="11" Foreground="#E4E8EF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#F24C1D"/>
                    <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverVeil" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverVeil" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="LblLibraryTitle" Text="Game Library" Style="{StaticResource PageTitle}"/>
                <Border Background="#FFD600" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center" Height="20">
                    <TextBlock Text="BETA" Foreground="#1A1A2E" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
            <TextBlock x:Name="LblLibraryDesc" Text="Your installed games from Steam, Epic, GOG, EA and more."
                       Style="{StaticResource PageDesc}"/>
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Background="#12FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,0" Height="42">
                <Grid>
                    <TextBlock x:Name="LblSearchPlaceholder" Text="Search games..." Foreground="#5A6370"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBox x:Name="TxtSearch" Background="Transparent" BorderThickness="0"
                             Foreground="#F7F8FA" CaretBrush="#F24C1D" FontSize="13.5"
                             VerticalAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                </Grid>
            </Border>

            <Button x:Name="BtnRefresh" Grid.Column="1" Content="Refresh Library"
                    Style="{StaticResource LibraryGhostBtn}" Margin="10,0,0,0" Click="BtnRefresh_Click"/>
            <Button x:Name="BtnAddGame" Grid.Column="2" Content="Add Custom Game"
                    Style="{StaticResource LibraryPrimaryBtn}" Margin="8,0,0,0" Click="BtnAddGame_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer x:Name="LibraryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="LblGamesFound" Text="0 Games Found" Foreground="#8B93A3"
                               FontSize="12.5" Margin="2,0,0,12"/>
                    <ItemsControl x:Name="GamesItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock x:Name="LblEmpty" Text="No games found yet. Click Refresh Library or add a custom EXE."
                               Foreground="#6B7380" FontSize="13" Margin="4,24,0,0" Visibility="Collapsed"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="BusyOverlay" Background="#880B0C0E" CornerRadius="12" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="LblScanning" Text="Scanning libraries…" Foreground="#FFFFFF"
                               FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4" Margin="0,14,0,0"
                                 Foreground="#F24C1D" Background="#22FFFFFF"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
