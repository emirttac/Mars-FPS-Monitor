<Window x:Class="FPSOverlay.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FPSOverlay"
        Title="Mars FPS Monitor" Height="720" Width="1220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        FontFamily="pack://application:,,,/Assets/Fonts/#Outfit">

    <Border CornerRadius="20" BorderThickness="1" BorderBrush="#28FFFFFF" ClipToBounds="True"
            Background="#0B0C0E">
        <Grid>
            <!-- Static backdrop only. Caching the whole window made every tab fade
                 re-rasterize the bitmap and hitch. -->
            <Grid IsHitTestVisible="False">
                <Grid.CacheMode>
                    <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="True"/>
                </Grid.CacheMode>
            <Border CornerRadius="20" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0B0C0E" Offset="0"/>
                        <GradientStop Color="#10131A" Offset="0.45"/>
                        <GradientStop Color="#140E12" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-160,-180" IsHitTestVisible="False" Opacity="0.35">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#55F24C1D" Offset="0"/>
                        <GradientStop Color="#00E31E24" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="380" Height="380" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-140,-120,0,0" IsHitTestVisible="False" Opacity="0.2">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#33406090" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            </Grid>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TITLE BAR — drag me -->
                <Border Grid.Row="0" Background="#0AFFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="24,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image x:Name="ImgBrandLogo" Source="pack://application:,,,/Assets/mars-logo.png"
                                   Width="44" Height="44" Margin="0,0,14,0" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="LowQuality"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Image.RenderTransform>
                            </Image>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="LblBrandTitle" Text="Mars" Foreground="#F7F8FA" FontSize="18" FontWeight="Bold"
                                           FontFamily="{StaticResource FontDisplay}"/>
                                <TextBlock x:Name="LblBrandSubtitle" Text="FPS Monitor" Foreground="#6B7380" FontSize="11.5" Margin="0,1,0,0"
                                           FontFamily="{StaticResource FontBody}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#12FFFFFF" CornerRadius="8" Padding="10,5" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LblTitleVersion" Text="v3.0" Foreground="#8B93A3" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <Button Content="—" Style="{StaticResource TitleBarBtn}" Click="BtnMinimize_Click"/>
                            <Button Content="✕" Style="{StaticResource CloseBtn}" Click="BtnClose_Click" Margin="2,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- BODY — the real content -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT NAV — tab party -->
                    <Border Grid.Column="0" Background="#08FFFFFF" Margin="12,8,0,16" CornerRadius="16">
                        <DockPanel Margin="12,20,12,16">
                            <TextBlock x:Name="LblNavHeader" DockPanel.Dock="Top" Text="NAVIGATE"
                                       Style="{StaticResource SectionHeader}" Margin="10,0,0,8"/>
                            <StackPanel DockPanel.Dock="Top">
                                <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" IsChecked="True" Checked="Nav_Checked" Tag="Home">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIcon}" Data="M4,11 L12,4 L20,11 M4,11 V20 H10 V14 H14 V20 H20 V11"/>
                                        <TextBlock x:Name="NavHomeLabel" Text="Home" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavLibrary" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="Library">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIcon}" Data="M6,4 H17 V20 H8.5 A2.5,2.5 0 0 1 6,17.5 V4 Z M6,17.5 H17"/>
                                        <TextBlock x:Name="NavLibraryLabel" Text="Library" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavOverlay" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="Overlay">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIcon}" Data="M12,3 L21,8 L12,13 L3,8 Z M3,12 L12,17 L21,12 M3,16 L12,21 L21,16"/>
                                        <TextBlock x:Name="NavOverlayLabel" Text="Overlay" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavSensors" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="Sensors">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIcon}" Data="M3,12 H7 L10,5 L14,19 L17,12 H21"/>
                                        <TextBlock x:Name="NavSensorsLabel" Text="Sensors" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavDisplay" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="Display">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIcon}" Data="M4,5 H20 V16 H4 Z M8,20 H16 M12,16 V20"/>
                                        <TextBlock x:Name="NavDisplayLabel" Text="Display" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavOverclock" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="Overclock">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIcon}" Data="M13,2 L5,13 H11 L10,22 L19,10 H13 Z"/>
                                        <TextBlock x:Name="NavOverclockLabel" Text="Overclock" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavFans" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="Fans">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIcon}" Data="M12,10.3 A1.7,1.7 0 1 1 11.9,10.3 M12,10 C12,6 15,4 18,5.5 M14.2,12.4 C18,12 20,15 18.5,18 M12,14 C12,18 9,20 6,18.5 M9.8,11.6 C6,12 4,9 5.5,6"/>
                                        <TextBlock x:Name="NavFansLabel" Text="Fans" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <Grid>
                                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="About">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource NavIcon}" Data="M12,4 A8,8 0 1 1 11.9,4 M12,11 V17 M12,8.2 V8"/>
                                            <TextBlock x:Name="NavAboutLabel" Text="About" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <TextBlock x:Name="NavAboutUpdateBadge" Text="⚠" Foreground="#FFD600" FontSize="14" FontWeight="Bold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                               Visibility="Collapsed" IsHitTestVisible="False"/>
                                </Grid>
                            </StackPanel>
                            <TextBlock x:Name="LblNavGitHub" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="10,0,0,4"
                                       Text="github.com/emirttac" Foreground="#4A5160" FontSize="11"
                                       Cursor="Hand" MouseLeftButtonDown="GitHub_Click"/>
                        </DockPanel>
                    </Border>

                    <!-- CONTENT panes -->
                    <Grid Grid.Column="1" Margin="28,12,28,20">

                        <!-- HOME — dashboard gauges -->
                        <ScrollViewer x:Name="PanelHome" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                            <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                                <TextBlock x:Name="LblPageHome" Text="Home" Style="{StaticResource PageTitle}"/>
                                <TextBlock x:Name="LblPageHomeDesc" Text="Live CPU and GPU temperatures — dashboard style."
                                           Style="{StaticResource PageDesc}"/>

                                <Border Style="{StaticResource SectionCard}" Padding="28,26" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock x:Name="LblHomeGaugesHeader" Text="THERMAL DASHBOARD" Style="{StaticResource SectionHeader}" Margin="0,0,0,18"/>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <local:TempGaugeControl x:Name="GaugeCpu" Grid.Column="0"
                                                                    Title="CPU" Subtitle="Temperature" Maximum="110"
                                                                    Accent="#19D4FC"
                                                                    HorizontalAlignment="Center"/>
                                            <local:TempGaugeControl x:Name="GaugeGpu" Grid.Column="2"
                                                                    Title="GPU" Subtitle="Temperature" Maximum="110"
                                                                    Accent="#19D4FC"
                                                                    HorizontalAlignment="Center"/>
                                            <local:RamGaugeControl x:Name="GaugeRam" Grid.Column="4"
                                                                   Title="RAM" Subtitle="Memory" Maximum="100"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Margin="4,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- LIBRARY — installed games -->
                        <local:LibraryView x:Name="PanelLibrary" Visibility="Collapsed"/>

                        <!-- OVERLAY settings -->
                        <ScrollViewer x:Name="PanelOverlay" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                                <TextBlock x:Name="LblPageOverlay" Text="Overlay" Style="{StaticResource PageTitle}"/>
                                <TextBlock x:Name="LblPageOverlayDesc" Text="Choose how the in-game overlay looks and behaves."
                                           Style="{StaticResource PageDesc}"/>

                                <Border Style="{StaticResource SectionCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="LblOverlayCtrl" Text="OVERLAY" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="LblOverlayToggle" Text="Show / hide on screen. Windowed uses Mars HUD; exclusive fullscreen uses RTSS automatically."
                                                       Foreground="#8B93A3" FontSize="13" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkOverlayActive" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="0"
                                                  IsChecked="True" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="LblProfile" Text="PROFILE" Style="{StaticResource SectionHeader}"/>
                                        <ComboBox x:Name="CmbProfile" Height="42" FontSize="13.5" SelectionChanged="InteractiveElement_Changed">
                                            <ComboBoxItem Content="Classic Minimalist" Tag="0"/>
                                            <ComboBoxItem Content="Gamer Panel" Tag="1"/>
                                            <ComboBoxItem Content="Steam Deck Style" Tag="2"/>
                                            <ComboBoxItem Content="Advanced Performance HUD" Tag="3"/>
                                            <ComboBoxItem Content="Compact Pill" Tag="4"/>
                                            <ComboBoxItem Content="Neon Glass" Tag="5"/>
                                            <ComboBoxItem Content="Tower" Tag="6"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="LblLanguage" Text="LANGUAGE" Style="{StaticResource SectionHeader}"/>
                                        <ComboBox x:Name="CmbLanguage" Height="42" FontSize="13.5" SelectionChanged="InteractiveElement_Changed">
                                            <ComboBoxItem Content="Türkçe (TR)" Tag="TR"/>
                                            <ComboBoxItem Content="English (EN)" Tag="EN"/>
                                            <ComboBoxItem Content="Azərbaycan (AZ)" Tag="AZ"/>
                                            <ComboBoxItem Content="Deutsch (DE)" Tag="DE"/>
                                            <ComboBoxItem Content="Español (ES)" Tag="ES"/>
                                            <ComboBoxItem Content="Français (FR)" Tag="FR"/>
                                            <ComboBoxItem Content="Português (PT)" Tag="PT"/>
                                            <ComboBoxItem Content="Português Brasil (BR)" Tag="BR"/>
                                            <ComboBoxItem Content="Русский (RU)" Tag="RU"/>
                                            <ComboBoxItem Content="中文 (ZH)" Tag="ZH"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- SENSORS toggles -->
                        <ScrollViewer x:Name="PanelSensors" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                                <TextBlock x:Name="LblPageSensors" Text="Sensors" Style="{StaticResource PageTitle}"/>
                                <TextBlock x:Name="LblPageSensorsDesc" Text="Pick which hardware metrics appear on the overlay."
                                           Style="{StaticResource PageDesc}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="280"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*" MinWidth="240"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                                        <StackPanel>
                                            <TextBlock x:Name="LblSensors" Text="METRICS" Style="{StaticResource SectionHeader}"/>
                                            <CheckBox x:Name="ChkShowFps" Style="{StaticResource ToggleSwitch}" Content="FPS" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed"/>
                                            <CheckBox x:Name="ChkShowFrametime" Style="{StaticResource ToggleSwitch}" Content="Frametime" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed"/>
                                            <CheckBox x:Name="ChkShowOnePercent" Style="{StaticResource ToggleSwitch}" Content="1% Low" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed"/>
                                            <CheckBox x:Name="ChkShowGpuName" Style="{StaticResource ToggleSwitch}" Content="Show GPU Name" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed"/>
                                            <CheckBox x:Name="ChkShowCpu" Style="{StaticResource ToggleSwitch}" Content="CPU Temp" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed"/>
                                            <CheckBox x:Name="ChkShowCpuLoad" Style="{StaticResource ToggleSwitch}" Content="CPU Load" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed"/>
                                            <CheckBox x:Name="ChkShowGpu" Style="{StaticResource ToggleSwitch}" Content="GPU Temp" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed"/>
                                            <CheckBox x:Name="ChkShowGpuLoad" Style="{StaticResource ToggleSwitch}" Content="GPU Load" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed"/>
                                            <CheckBox x:Name="ChkShowRam" Style="{StaticResource ToggleSwitch}" Content="RAM Usage" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed"/>
                                            <CheckBox x:Name="ChkShowVram" Style="{StaticResource ToggleSwitch}" Content="VRAM Usage" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed"/>
                                            <CheckBox x:Name="ChkShowOc" Style="{StaticResource ToggleSwitch}" Content="Overclock Status" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed"/>
                                            <CheckBox x:Name="ChkShowFan" Style="{StaticResource ToggleSwitch}" Content="Fan speed" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed"/>
                                            <CheckBox x:Name="ChkShowClock" Style="{StaticResource ToggleSwitch}" Content="Clock" Margin="0" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource SectionCard}" VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock x:Name="LblGpuSelect" Text="ACTIVE GPU" Style="{StaticResource SectionHeader}"/>
                                            <ComboBox x:Name="CmbGpuSelector" Height="42" FontSize="13.5" SelectionChanged="InteractiveElement_Changed"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- DISPLAY look & feel -->
                        <ScrollViewer x:Name="PanelDisplay" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                                <TextBlock x:Name="LblPageDisplay" Text="Display" Style="{StaticResource PageTitle}"/>
                                <TextBlock x:Name="LblPageDisplayDesc" Text="Color, size, and on-screen placement."
                                           Style="{StaticResource PageDesc}"/>

                                <Border Style="{StaticResource SectionCard}" Padding="22,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="LblPreview" Text="LIVE PREVIEW" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                                            <TextBlock x:Name="PreviewSampleText" Text="144 FPS  ·  GPU 62°C  ·  CPU 48°C"
                                                       FontSize="18" FontWeight="Bold"
                                                       FontFamily="{StaticResource FontDisplay}"/>
                                        </StackPanel>
                                        <Border x:Name="ColorPreview" Grid.Column="1" Width="44" Height="44" CornerRadius="12"
                                                Background="#00E68A" BorderBrush="#22FFFFFF" BorderThickness="1" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="LblAppearance" Text="APPEARANCE" Style="{StaticResource SectionHeader}"/>
                                        <TextBlock x:Name="LblOverlayColor" Text="Overlay color" Style="{StaticResource FieldLabel}" Margin="0,0,0,10"/>
                                        <Button x:Name="BtnCustomColor" Content="Pick color" Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Left" Click="BtnCustomColor_Click" Margin="0,0,0,22"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LblFontSize" Text="Size" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <Slider x:Name="SliderFontSize" Grid.Column="1" Minimum="10" Maximum="48" Value="20"
                                                    TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderFontSize_ValueChanged" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtFontSizeVal" Grid.Column="2" Text="20 px" Style="{StaticResource AccentValue}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="LblPosition" Text="POSITION" Style="{StaticResource SectionHeader}"/>
                                        <CheckBox x:Name="ChkPositionUnlock" Style="{StaticResource ToggleSwitch}" Content="Unlock position (drag)"
                                                  Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed"/>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="#0C0E12" CornerRadius="14" Padding="10" BorderBrush="#18FFFFFF" BorderThickness="1" Margin="0,0,22,0">
                                                <UniformGrid Rows="3" Columns="3" Width="84" Height="84">
                                                    <RadioButton x:Name="PosTL" Style="{StaticResource PosBtn}" Tag="TopLeft" Checked="InteractiveElement_Changed"/>
                                                    <RadioButton x:Name="PosTC" Style="{StaticResource PosBtn}" Tag="TopCenter" Checked="InteractiveElement_Changed"/>
                                                    <RadioButton x:Name="PosTR" Style="{StaticResource PosBtn}" Tag="TopRight" Checked="InteractiveElement_Changed"/>
                                                    <RadioButton x:Name="PosML" Style="{StaticResource PosBtn}" Tag="MiddleLeft" Checked="InteractiveElement_Changed"/>
                                                    <RadioButton x:Name="PosMC" Style="{StaticResource PosBtn}" Tag="Center" Checked="InteractiveElement_Changed"/>
                                                    <RadioButton x:Name="PosMR" Style="{StaticResource PosBtn}" Tag="MiddleRight" Checked="InteractiveElement_Changed"/>
                                                    <RadioButton x:Name="PosBL" Style="{StaticResource PosBtn}" Tag="BottomLeft" Checked="InteractiveElement_Changed"/>
                                                    <RadioButton x:Name="PosBC" Style="{StaticResource PosBtn}" Tag="BottomCenter" Checked="InteractiveElement_Changed"/>
                                                    <RadioButton x:Name="PosBR" Style="{StaticResource PosBtn}" Tag="BottomRight" Checked="InteractiveElement_Changed"/>
                                                </UniformGrid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock x:Name="LblPadding" Text="Padding" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                                                    <TextBlock x:Name="TxtPaddingVal" Text="25 px" Style="{StaticResource AccentValue}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider x:Name="SliderPadding" Minimum="0" Maximum="100" Value="25"
                                                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderPadding_ValueChanged"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- OVERCLOCK — clean 2-column layout -->
                        <ScrollViewer x:Name="PanelOverclock" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="LblPageOverclock" Text="Overclock" Style="{StaticResource PageTitle}"/>
                                <TextBlock x:Name="LblPageOverclockDesc" Text="Control mode, live status, AI suggestions, and your profiles."
                                           Style="{StaticResource PageDesc}" Margin="0,0,0,20"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="280"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="1.2*" MinWidth="320"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT: mode + active status -->
                                    <StackPanel Grid.Column="0">
                                        <Border Style="{StaticResource SectionCard}" Padding="14" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock x:Name="LblOcModeHeader" Text="CONTROL MODE" Style="{StaticResource SectionHeader}" Margin="4,0,0,10"/>
                                                <Border Background="#0C0E12" CornerRadius="14" Padding="4" BorderBrush="#14FFFFFF" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <RadioButton x:Name="RadOcOff" Grid.Column="0" Style="{StaticResource ModeSegment}"
                                                                     Content="Kapalı" GroupName="OcMode" Checked="OcMode_Changed"/>
                                                        <RadioButton x:Name="RadOcAuto" Grid.Column="1" Style="{StaticResource ModeSegment}"
                                                                     Content="Otomatik" GroupName="OcMode" Checked="OcMode_Changed"/>
                                                        <RadioButton x:Name="RadOcManual" Grid.Column="2" Style="{StaticResource ModeSegment}"
                                                                     Content="Manuel" GroupName="OcMode" Checked="OcMode_Changed"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel x:Name="PanelManualProfile" Margin="4,12,4,0">
                                                    <TextBlock x:Name="LblOcManualLevel" Text="Fixed profile" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                                    <ComboBox x:Name="CmbManualProfile" Height="38" FontSize="13" SelectionChanged="OcManualProfile_Changed"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SectionCard}" Padding="20" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock x:Name="LblOcActiveHeader" Text="ACTIVE NOW" Style="{StaticResource SectionHeader}"/>
                                                <TextBlock x:Name="TxtOcLevel" Text="Safe / Off" FontSize="26" FontWeight="Bold"
                                                           Foreground="#F7F8FA" FontFamily="{StaticResource FontDisplay}" Margin="0,0,0,6"/>
                                                <TextBlock x:Name="LblOcLevelLabel" Text="Active profile" Style="{StaticResource FieldLabel}" Margin="0,0,0,16" Visibility="Collapsed"/>

                                                <Grid Margin="0,0,0,18">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock x:Name="LblOcTempLabel" Text="GPU temperature" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                                        <TextBlock x:Name="TxtOcTemp" Text="—" FontSize="22" FontFamily="{StaticResource FontMono}" Foreground="#FF4D5A"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock x:Name="LblOcHotspotLabel" Text="Hotspot" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                                        <TextBlock x:Name="TxtOcHotspot" Text="—" FontSize="22" FontFamily="{StaticResource FontMono}" Foreground="#E8ECF2"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock x:Name="LblOcAppliedHeader" Text="Applied values" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                                                <Border Background="#0C0E12" CornerRadius="14" Padding="14" BorderBrush="#14FFFFFF" BorderThickness="1">
                                                    <UniformGrid Columns="3">
                                                        <StackPanel Margin="0,0,8,0">
                                                            <TextBlock x:Name="LblOcCoreTag" Text="Core" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                            <TextBlock x:Name="TxtOcCore" Text="+0" FontSize="16" FontFamily="{StaticResource FontMono}" Foreground="#F4F5F7"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="4,0">
                                                            <TextBlock x:Name="LblOcMemTag" Text="Memory" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                            <TextBlock x:Name="TxtOcMem" Text="+0" FontSize="16" FontFamily="{StaticResource FontMono}" Foreground="#F4F5F7"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="8,0,0,0">
                                                            <TextBlock x:Name="LblOcPowerTag" Text="Power" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                            <TextBlock x:Name="TxtOcPower" Text="stock" FontSize="16" FontFamily="{StaticResource FontMono}" Foreground="#F4F5F7"/>
                                                        </StackPanel>
                                                    </UniformGrid>
                                                </Border>

                                                <!-- Hidden debug sinks (kept so codegen doesn't cry) -->
                                                <TextBlock x:Name="TxtOcGpuStatus" Visibility="Collapsed"/>
                                                <TextBlock x:Name="TxtOcGpuProvider" Visibility="Collapsed"/>
                                                <TextBlock x:Name="TxtOcVendor" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblOcGpuProviderLabel" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblOcVendorLabel" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblOcStatusHeader" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LblOcDisclaimer" Visibility="Collapsed"/>
                                                <Button x:Name="BtnOcRefresh" Visibility="Collapsed" Click="BtnOcRefresh_Click"/>
                                            </StackPanel>
                                        </Border>

                                        <Button x:Name="BtnOcRestore" Content="Turn off &amp; restore" Style="{StaticResource GhostButton}"
                                                HorizontalAlignment="Left" Click="BtnOcRestore_Click"/>
                                    </StackPanel>

                                    <!-- RIGHT: AI + profiles -->
                                    <StackPanel Grid.Column="2">
                                        <Border Style="{StaticResource SectionCard}" Padding="16" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock x:Name="LblAiOcHeader" Text="AI ASSISTANT" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                                                <TextBlock x:Name="LblAiOcDesc" Text="Conservative suggestions. Nothing is applied until you save."
                                                           Foreground="#8B93A3" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <Button x:Name="BtnAiOcAsk" Content="Get AI suggestion" Style="{StaticResource PrimaryButton}"
                                                            Click="BtnAiOcAsk_Click" Margin="0,0,10,0"/>
                                                    <Button x:Name="BtnAiOcSaveAll" Content="Save all" Style="{StaticResource SecondaryButton}"
                                                            Click="BtnAiOcSaveAll_Click" IsEnabled="False"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtAiOcStatus" Text="" Foreground="#6B7380" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                                <UniformGrid Columns="3">
                                                    <Border x:Name="CardAiEco" Background="#0C0E12" CornerRadius="12" Padding="12" Margin="0,0,6,0"
                                                            BorderBrush="#14FFFFFF" BorderThickness="1" Opacity="0.5">
                                                        <StackPanel>
                                                            <TextBlock Text="Eco" FontFamily="{StaticResource FontDisplay}" FontWeight="Bold" FontSize="14" Foreground="#F7F8FA" Margin="0,0,0,8"/>
                                                            <TextBlock x:Name="TxtAiEcoOffsets" Text="—" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="#E8ECF2"/>
                                                            <TextBlock x:Name="TxtAiEcoBand" Text="" Style="{StaticResource FieldLabel}" Margin="0,4,0,0"/>
                                                            <TextBlock x:Name="TxtAiEcoPl" Text="" Style="{StaticResource FieldLabel}" Margin="0,2,0,8"/>
                                                            <TextBlock x:Name="TxtAiEcoWhy" Visibility="Collapsed"/>
                                                            <Button x:Name="BtnAiEcoSave" Content="Save" Style="{StaticResource ChipButton}" Margin="0" Click="BtnAiOcSaveOne_Click" Tag="Eco" IsEnabled="False"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="CardAiPerf" Background="#0C0E12" CornerRadius="12" Padding="12" Margin="3,0"
                                                            BorderBrush="#14FFFFFF" BorderThickness="1" Opacity="0.5">
                                                        <StackPanel>
                                                            <TextBlock Text="Performance" FontFamily="{StaticResource FontDisplay}" FontWeight="Bold" FontSize="14" Foreground="#F7F8FA" Margin="0,0,0,8"/>
                                                            <TextBlock x:Name="TxtAiPerfOffsets" Text="—" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="#E8ECF2"/>
                                                            <TextBlock x:Name="TxtAiPerfBand" Text="" Style="{StaticResource FieldLabel}" Margin="0,4,0,0"/>
                                                            <TextBlock x:Name="TxtAiPerfPl" Text="" Style="{StaticResource FieldLabel}" Margin="0,2,0,8"/>
                                                            <TextBlock x:Name="TxtAiPerfWhy" Visibility="Collapsed"/>
                                                            <Button x:Name="BtnAiPerfSave" Content="Save" Style="{StaticResource ChipButton}" Margin="0" Click="BtnAiOcSaveOne_Click" Tag="Performance" IsEnabled="False"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="CardAiExt" Background="#0C0E12" CornerRadius="12" Padding="12" Margin="6,0,0,0"
                                                            BorderBrush="#14FFFFFF" BorderThickness="1" Opacity="0.5">
                                                        <StackPanel>
                                                            <TextBlock Text="Extreme" FontFamily="{StaticResource FontDisplay}" FontWeight="Bold" FontSize="14" Foreground="#F7F8FA" Margin="0,0,0,8"/>
                                                            <TextBlock x:Name="TxtAiExtOffsets" Text="—" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="#E8ECF2"/>
                                                            <TextBlock x:Name="TxtAiExtBand" Text="" Style="{StaticResource FieldLabel}" Margin="0,4,0,0"/>
                                                            <TextBlock x:Name="TxtAiExtPl" Text="" Style="{StaticResource FieldLabel}" Margin="0,2,0,8"/>
                                                            <TextBlock x:Name="TxtAiExtWhy" Visibility="Collapsed"/>
                                                            <Button x:Name="BtnAiExtSave" Content="Save" Style="{StaticResource ChipButton}" Margin="0" Click="BtnAiOcSaveOne_Click" Tag="Extreme" IsEnabled="False"/>
                                                        </StackPanel>
                                                    </Border>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SectionCard}" Padding="0" Margin="0" ClipToBounds="True">
                                            <StackPanel>
                                                <!-- Profiles header + toolbar -->
                                                <Border Padding="16,14,16,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1">
                                                    <StackPanel>
                                                        <TextBlock x:Name="LblOcProfilesHeader" Text="PROFİLLERİM" Style="{StaticResource SectionHeader}"
                                                                   Margin="0,0,0,10"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button x:Name="BtnOcProfileAdd" Content="Add" Style="{StaticResource ProfileToolButton}"
                                                                        Click="BtnOcProfileAdd_Click" Margin="0,0,6,0"/>
                                                                <Button x:Name="BtnOcProfileSave" Content="Save" Style="{StaticResource ProfileToolButton}"
                                                                        Click="BtnOcProfileSave_Click" Margin="0,0,6,0"/>
                                                                <Button x:Name="BtnOcProfileDelete" Content="Delete" Style="{StaticResource ProfileToolButton}"
                                                                        Click="BtnOcProfileDelete_Click"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <Button x:Name="BtnOcProfileImport" Content="Import" Style="{StaticResource ProfileToolButton}"
                                                                        Click="BtnOcProfileImport_Click" Margin="0,0,6,0"/>
                                                                <Button x:Name="BtnOcProfileExport" Content="Export" Style="{StaticResource ProfileToolButton}"
                                                                        Click="BtnOcProfileExport_Click" Margin="0,0,6,0"/>
                                                                <Button x:Name="BtnOcProfileDefaults" Content="Defaults" Style="{StaticResource ProfileToolButton}"
                                                                        Click="BtnOcProfileDefaults_Click"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <ListBox x:Name="LstOcProfiles" Height="148" Margin="12,12,12,0"
                                                         BorderThickness="0" Background="Transparent" Padding="0"
                                                         SelectionChanged="LstOcProfiles_SelectionChanged"/>

                                                <!-- Edit strip — tweak the sauce -->
                                                <Border Margin="12,14,12,12" Background="#0C0E12" CornerRadius="14"
                                                        BorderBrush="#14FFFFFF" BorderThickness="1" Padding="14">
                                                    <StackPanel>
                                                        <TextBlock x:Name="LblOcEditHeader" Text="EDIT" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                                                        <Grid Margin="0,0,0,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.5*"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock x:Name="LblOcEditName" Text="Name" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="TxtOcEditName" Height="34" FontSize="12.5" Padding="10,4"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock x:Name="LblOcEditMin" Text="Min °C" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="TxtOcEditMin" Height="34" FontSize="12.5" Padding="10,4"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock x:Name="LblOcEditMax" Text="Max °C" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="TxtOcEditMax" Height="34" FontSize="12.5" Padding="10,4"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock x:Name="LblOcEditCore" Text="Core +MHz" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="TxtOcEditCore" Height="34" FontSize="12.5" Padding="10,4"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock x:Name="LblOcEditMem" Text="Mem +MHz" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="TxtOcEditMem" Height="34" FontSize="12.5" Padding="10,4"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock x:Name="LblOcEditPower" Text="Power %" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="TxtOcEditPower" Height="34" FontSize="12.5" Padding="10,4"
                                                                        ToolTip="empty = stock"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock x:Name="LblOcEditPowerHint" Text="empty = stock" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" Opacity="0.65"/>
                                                        <TextBlock x:Name="TxtOcProfileMsg" Text="" Foreground="#C89090" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- FANS — curve control -->
                        <ScrollViewer x:Name="PanelFans" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <TextBlock x:Name="LblPageFans" Text="Fans" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
                                    <Border Background="#FFD600" CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                                            VerticalAlignment="Center" Height="20">
                                        <TextBlock Text="BETA" Foreground="#1A1A2E" FontSize="10" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Button x:Name="BtnFanBetaInfo" Width="22" Height="22" Margin="8,0,0,0"
                                            VerticalAlignment="Center" Cursor="Hand" Click="BtnFanBetaInfo_Click"
                                            ToolTip="About Fans (Beta)">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Width="22" Height="22" CornerRadius="11"
                                                        Background="#18FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                    <TextBlock Text="i" FontSize="12" FontWeight="Bold" FontStyle="Italic"
                                                               Foreground="#C8CED8" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#28F24C1D"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#66F24C1D"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#40F24C1D"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="LblPageFansDesc" Text="Fan curves when the hardware exposes PWM. Otherwise RPM is read-only and BIOS/EC stays in control."
                                           Style="{StaticResource PageDesc}" Margin="0,0,0,20"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="280"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="1.2*" MinWidth="320"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <Border Style="{StaticResource SectionCard}" Padding="14" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock x:Name="LblFanModeHeader" Text="CONTROL MODE" Style="{StaticResource SectionHeader}" Margin="4,0,0,10"/>
                                                <Border Background="#0C0E12" CornerRadius="14" Padding="4" BorderBrush="#14FFFFFF" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <RadioButton x:Name="RadFanOff" Grid.Column="0" Style="{StaticResource ModeSegment}"
                                                                     Content="Off" GroupName="FanMode" IsChecked="True" Checked="FanMode_Changed"/>
                                                        <RadioButton x:Name="RadFanAuto" Grid.Column="1" Style="{StaticResource ModeSegment}"
                                                                     Content="Auto" GroupName="FanMode" Checked="FanMode_Changed"/>
                                                        <RadioButton x:Name="RadFanManual" Grid.Column="2" Style="{StaticResource ModeSegment}"
                                                                     Content="Manual" GroupName="FanMode" Checked="FanMode_Changed"/>
                                                    </Grid>
                                                </Border>

                                                <StackPanel x:Name="PanelFanManual" Margin="4,12,4,0" Visibility="Collapsed">
                                                    <Grid Margin="0,0,0,6">
                                                        <TextBlock x:Name="LblFanManualPwm" Text="Fixed PWM" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                                                        <TextBlock x:Name="TxtFanManualValue" Text="40%" Style="{StaticResource AccentValue}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Slider x:Name="SldFanManual" Minimum="0" Maximum="100" Value="40"
                                                            TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FanManual_Changed"/>
                                                </StackPanel>

                                                <StackPanel x:Name="PanelFanCurvePick" Margin="4,12,4,0">
                                                    <TextBlock x:Name="LblFanCurvePick" Text="Curve" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                                    <ComboBox x:Name="CmbFanCurve" Height="38" FontSize="13"
                                                              SelectionChanged="FanCurve_Changed"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SectionCard}" Padding="20" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock x:Name="LblFanActiveHeader" Text="ACTIVE NOW" Style="{StaticResource SectionHeader}"/>
                                                <TextBlock x:Name="TxtFanLevel" Text="BIOS / Auto" FontSize="26" FontWeight="Bold"
                                                           Foreground="#F7F8FA" FontFamily="{StaticResource FontDisplay}" Margin="0,0,0,12"/>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock x:Name="LblFanCpuTemp" Text="CPU temperature" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                                        <TextBlock x:Name="TxtFanCpuTemp" Text="—" FontSize="22" FontFamily="{StaticResource FontMono}" Foreground="#FF4D5A"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock x:Name="LblFanGpuTemp" Text="GPU temperature" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                                        <TextBlock x:Name="TxtFanGpuTemp" Text="—" FontSize="22" FontFamily="{StaticResource FontMono}" Foreground="#E8ECF2"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock x:Name="TxtFanBackend" Text="" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="TxtFanStatus" Text="" Foreground="#8B93A3" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <TextBlock x:Name="TxtFanPawnHint" Text="" Foreground="#6B7380" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                                <Button x:Name="BtnFanRestore" Content="Turn off &amp; restore" Style="{StaticResource GhostButton}"
                                                        HorizontalAlignment="Left" Click="BtnFanRestore_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <Border Style="{StaticResource SectionCard}" Padding="16" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock x:Name="LblFanChannelsHeader" Text="CHANNELS" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                                                <TextBlock x:Name="LblFanEmpty" Text="No fan sensors on this device."
                                                           Foreground="#6B7380" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
                                                <ItemsControl x:Name="LstFanChannels">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#0C0E12" CornerRadius="12" Padding="12,10" Margin="0,0,0,8"
                                                                    BorderBrush="#14FFFFFF" BorderThickness="1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}" Foreground="#F4F5F7" FontSize="13" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{Binding Backend}" Foreground="#6B7380" FontSize="11" Margin="0,2,0,0"/>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                            <TextBlock Text="{Binding RpmText}" FontFamily="{StaticResource FontMono}" Foreground="#E8ECF2" FontSize="12" Margin="0,0,12,0"/>
                                                                            <TextBlock Text="{Binding PwmText}" FontFamily="{StaticResource FontMono}" Foreground="#E8ECF2" FontSize="12"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Badge}" VerticalAlignment="Top"
                                                                               Foreground="#8B93A3" FontSize="11" Margin="8,0,0,0"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SectionCard}" Padding="16">
                                            <StackPanel>
                                                <TextBlock x:Name="LblFanCurvesHeader" Text="CURVE POINTS" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                                                <TextBlock x:Name="TxtFanCurvePoints" Text="—" FontFamily="{StaticResource FontMono}"
                                                           FontSize="12.5" Foreground="#E8ECF2" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnFanPresetSilent" Content="Silent" Style="{StaticResource ChipButton}"
                                                            Margin="0,0,8,0" Click="BtnFanPreset_Click" Tag="Silent"/>
                                                    <Button x:Name="BtnFanPresetBalanced" Content="Balanced" Style="{StaticResource ChipButton}"
                                                            Margin="0,0,8,0" Click="BtnFanPreset_Click" Tag="Balanced"/>
                                                    <Button x:Name="BtnFanPresetPerformance" Content="Performance" Style="{StaticResource ChipButton}"
                                                            Click="BtnFanPreset_Click" Tag="Performance"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ABOUT — who we are -->
                        <ScrollViewer x:Name="PanelAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                                <TextBlock x:Name="LblPageAbout" Text="About" Style="{StaticResource PageTitle}"/>
                                <TextBlock x:Name="LblPageAboutDesc" Text="Product info and community."
                                           Style="{StaticResource PageDesc}"/>

                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                            <Border Width="64" Height="64" CornerRadius="18" Margin="0,0,16,0"
                                                    Background="Transparent">
                                                <Image Source="pack://application:,,,/Assets/mars-logo.png" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="LblAboutBrand" Text="Mars FPS Monitor" Foreground="#F7F8FA" FontSize="22" FontWeight="Bold"
                                                           FontFamily="{StaticResource FontDisplay}"/>
                                                <TextBlock x:Name="LblAboutVersion" Text="v3.0" Foreground="#8B93A3" FontSize="13" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock x:Name="LblAboutBody"
                                                   Text="A lightweight, injection-free performance overlay for Windows. Track FPS, frametime, and hardware metrics without interrupting your game."
                                                   Foreground="#9AA3B2" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,16"/>

                                        <Button x:Name="BtnCheckUpdates" Content="Check for updates" Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Left" Margin="0,0,0,10" Click="BtnCheckUpdates_Click"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button x:Name="BtnOpenDebugLog" Content="Open debug log" Style="{StaticResource GhostButton}"
                                                    HorizontalAlignment="Left" Margin="0,0,10,0" Click="BtnOpenDebugLog_Click"/>
                                            <Button x:Name="BtnOpenLogFolder" Content="Open log folder" Style="{StaticResource GhostButton}"
                                                    HorizontalAlignment="Left" Click="BtnOpenLogFolder_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtUpdateStatus" Text="" Foreground="#8B93A3" FontSize="12.5"
                                                   TextWrapping="Wrap" Margin="0,0,0,18"/>

                                        <StackPanel>
                                            <Border Background="#0C0E12" CornerRadius="14" Padding="16" BorderBrush="#18FFFFFF" BorderThickness="1"
