<Window x:Class="FPSOverlay.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color" Height="540" Width="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="pack://application:,,,/Assets/Fonts/#Outfit">
    <Border CornerRadius="18" BorderBrush="#28FFFFFF" BorderThickness="1" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B0C0E" Offset="0"/>
                <GradientStop Color="#14171E" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.CacheMode>
                <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="True"/>
            </Grid.CacheMode>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0AFFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0,12,0">
                    <TextBlock x:Name="LblTitle" Text="Color" Foreground="#F7F8FA" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" FontFamily="{StaticResource FontDisplay}"/>
                    <Button Content="✕" Style="{StaticResource CloseBtn}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="BtnCancel_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="PickerGrid" Width="200" Height="200" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
                          MouseLeftButtonDown="PickerGrid_MouseDown" MouseMove="PickerGrid_MouseMove" MouseLeftButtonUp="PickerGrid_MouseUp">
                        <Image x:Name="ImgHueRing" Width="200" Height="200" IsHitTestVisible="False"/>

                        <Border Width="110" Height="110" HorizontalAlignment="Center" VerticalAlignment="Center"
                                BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False" ClipToBounds="True">
                            <Image x:Name="ImgSvSquare" Width="110" Height="110"/>
                        </Border>

                        <Canvas x:Name="OverlayCanvas" Width="200" Height="200" IsHitTestVisible="False">
                            <Ellipse x:Name="HueIndicator" Width="14" Height="14" Stroke="#FFF" StrokeThickness="2" Margin="-7,-7,0,0"/>
                            <Ellipse x:Name="SvIndicator" Width="10" Height="10" Stroke="#FFF" StrokeThickness="1.5" Margin="-5,-5,0,0"/>
                        </Canvas>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border x:Name="ColorPreview" Width="88" Height="40" CornerRadius="12" BorderBrush="#22FFFFFF" BorderThickness="1" Background="#FF0000"/>
                            <Button x:Name="BtnAddCustom" Content="+" Width="40" Height="40" Margin="10,0,0,0" FontSize="18"
                                    Style="{StaticResource SecondaryButton}" Padding="0" Click="BtnAddCustom_Click"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="R" Foreground="#8B93A3" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtR" Grid.Column="1" Height="36" VerticalContentAlignment="Center" TextChanged="RgbTextBox_TextChanged"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="G" Foreground="#8B93A3" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtG" Grid.Column="1" Height="36" VerticalContentAlignment="Center" TextChanged="RgbTextBox_TextChanged"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="B" Foreground="#8B93A3" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtB" Grid.Column="1" Height="36" VerticalContentAlignment="Center" TextChanged="RgbTextBox_TextChanged"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock x:Name="LblStandardColors" Text="Standard colors" Foreground="#9AA3B2" FontSize="12" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#FFFFFF" Tag="#FFFFFF" Width="30" Height="30" CornerRadius="8" Margin="0,0,8,0" MouseLeftButtonDown="StandardColor_Click" Cursor="Hand" BorderBrush="#22FFFFFF" BorderThickness="1"/>
                        <Border Background="#FF0000" Tag="#FF0000" Width="30" Height="30" CornerRadius="8" Margin="0,0,8,0" MouseLeftButtonDown="StandardColor_Click" Cursor="Hand" BorderBrush="#22FFFFFF" BorderThickness="1"/>
                        <Border Background="#FF8800" Tag="#FF8800" Width="30" Height="30" CornerRadius="8" Margin="0,0,8,0" MouseLeftButtonDown="StandardColor_Click" Cursor="Hand" BorderBrush="#22FFFFFF" BorderThickness="1"/>
                        <Border Background="#FFFF00" Tag="#FFFF00" Width="30" Height="30" CornerRadius="8" Margin="0,0,8,0" MouseLeftButtonDown="StandardColor_Click" Cursor="Hand" BorderBrush="#22FFFFFF" BorderThickness="1"/>
                        <Border Background="#00FF00" Tag="#00FF00" Width="30" Height="30" CornerRadius="8" Margin="0,0,8,0" MouseLeftButtonDown="StandardColor_Click" Cursor="Hand" BorderBrush="#22FFFFFF" BorderThickness="1"/>
                        <Border Background="#00FFFF" Tag="#00FFFF" Width="30" Height="30" CornerRadius="8" Margin="0,0,8,0" MouseLeftButtonDown="StandardColor_Click" Cursor="Hand" BorderBrush="#22FFFFFF" BorderThickness="1"/>
                        <Border Background="#0000FF" Tag="#0000FF" Width="30" Height="30" CornerRadius="8" Margin="0,0,8,0" MouseLeftButtonDown="StandardColor_Click" Cursor="Hand" BorderBrush="#22FFFFFF" BorderThickness="1"/>
                        <Border Background="#FF00FF" Tag="#FF00FF" Width="30" Height="30" CornerRadius="8" Margin="0,0,8,0" MouseLeftButtonDown="StandardColor_Click" Cursor="Hand" BorderBrush="#22FFFFFF" BorderThickness="1"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,18">
                    <Grid Margin="0,0,0,10">
                        <TextBlock x:Name="LblCustomColors" Text="Custom colors" Foreground="#9AA3B2" FontSize="12"/>
                        <Button x:Name="BtnDeleteCustom" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Background="Transparent"
                                Foreground="#6B7380" BorderThickness="0" FontSize="12" HorizontalAlignment="Right" Cursor="Hand" Click="BtnDeleteCustom_Click"/>
                    </Grid>
                    <StackPanel x:Name="CustomColorContainer" Orientation="Horizontal"/>
                </StackPanel>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnOk" Content="OK" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="BtnOk_Click"/>
                    <Button x:Name="BtnCancel" Grid.Column="1" Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BtnCancel_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
