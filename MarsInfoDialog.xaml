<Window x:Class="FPSOverlay.MarsInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mars FPS Monitor"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="pack://application:,,,/Assets/Fonts/#Outfit">

    <Grid>
        <!-- Dim veil over the Mars control panel -->
        <Border x:Name="DimBackdrop" Background="#CC06070A" Opacity="0"/>

        <!-- Elevated card -->
        <Border x:Name="CardRoot" HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="460" MaxWidth="460" CornerRadius="18" BorderThickness="1"
                BorderBrush="#38FFFFFF" ClipToBounds="True" Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.96" ScaleY="0.96" x:Name="CardScale"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Border CornerRadius="18" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#12141A" Offset="0"/>
                            <GradientStop Color="#161922" Offset="0.55"/>
                            <GradientStop Color="#1A1216" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Ellipse Width="280" Height="280" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-90,-110" IsHitTestVisible="False" Opacity="0.34">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#66F24C1D" Offset="0"/>
                            <GradientStop Color="#00E31E24" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <StackPanel Margin="26,24,26,24">
                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                        <Border DockPanel.Dock="Left" Background="#FFD600" CornerRadius="4"
                                Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center" Height="20">
                            <TextBlock Text="BETA" Foreground="#1A1A2E" FontSize="10" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="LblTitle" Text="Fans"
                                   Foreground="#F7F8FA" FontSize="18" FontWeight="Bold"
                                   FontFamily="{StaticResource FontDisplay}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>

                    <TextBlock x:Name="LblSubtitle" Text=""
                               Foreground="#8B93A3" FontSize="12.5" TextWrapping="Wrap"
                               Margin="0,0,0,14"/>

                    <Border Height="1" Background="#18FFFFFF" Margin="0,0,0,14"/>

                    <TextBlock x:Name="TxtBody" Text=""
                               Foreground="#D0D5DE" FontSize="13.5" TextWrapping="Wrap"
                               LineHeight="22" Margin="0,0,0,16"/>

                    <Border Background="#14F24C1D" BorderBrush="#33F24C1D" BorderThickness="1"
                            CornerRadius="12" Padding="14,12" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock x:Name="LblComingTitle" Text=""
                                       Foreground="#F24C1D" FontSize="12" FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtComingBody" Text=""
                                       Foreground="#C8CED8" FontSize="13" TextWrapping="Wrap"
                                       LineHeight="20"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnOk" Content="OK" HorizontalAlignment="Right"
                            MinWidth="120" Height="40" FontSize="13.5" FontWeight="SemiBold"
                            Cursor="Hand" Click="BtnOk_Click" IsDefault="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="12" Padding="18,0" Background="#F24C1D">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextBlock.Foreground="White"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FF5A2A"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#D93F12"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
